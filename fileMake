.PHONY: help create-network up down destroy rebuild compose logs ps otel otel-slim otel-metrics k6-tests sonarqube elk elk-gen-password man

indent_style = tab

RED    := \033[0;31m
GREEN  := \033[0;32m
YELLOW := \033[0;33m
NC     := \033[0m

# Arquivo compose da aplicação principal (usado só no "rebuild")
COMPOSE_FILE = docker-compose.yml

# Nome do projeto (usado no "ps" para listar todos os containers da stack de telemetria)
PROJECT_NAME := telemetry

# Mapeamento: palavra-chave -> arquivo(s) compose de telemetria
# (equivalente aos antigos "include" + "--profile" do docker-compose.telemetry.all.yml)
FILES_multipages   = -f docker/docker-compose.telemetry.multipages.yml
FILES_otel         = -f docker/otel/docker-compose.otel.yml
FILES_otel-slim    = -f docker/otel/docker-compose.otel-slim.yml
FILES_otel-metrics = -f docker/otel/docker-compose.otel-metrics.yml
FILES_grafana-dev  = -f docker/otel/traefik/lgtm.dev.yml
FILES_grafana-prod = $(FILES_grafana-dev) -f docker/otel/traefik/lgtm.prod.yml
FILES_jaeger       = -f docker/docker-compose.telemetry.jaeger.yml
FILES_prometheus   = -f docker/docker-compose.telemetry.prometheus.yml
FILES_grafana      = -f docker/docker-compose.telemetry.grafana.yml
FILES_k6           = -f docker/docker-compose.telemetry.k6.yml
FILES_sonarqube    = -f docker/docker-compose.telemetry.sonarqube.yml
FILES_elk          = -f docker/docker-compose.telemetry.elasticstack.yml

# Resolve qual arquivo de override do Grafana/Traefik usar, com base no argumento dev|prod
# passado depois de "otel-metrics" (ex: make otel-metrics prod)
GRAFANA_FILES := $(if $(filter prod,$(MAKECMDGOALS)),$(FILES_grafana-prod),$(if $(filter dev,$(MAKECMDGOALS)),$(FILES_grafana-dev),))

# Palavras reservadas que não devem ser resolvidas como FILES_<palavra> ao montar ARGS,
# pois são usadas como seletor de ambiente por "otel-metrics dev|prod", não como arquivo compose.
PROFILE_KEYWORDS := dev prod

ALL = $(FILES_multipages) $(FILES_otel) $(FILES_jaeger) $(FILES_prometheus) $(FILES_grafana) $(FILES_k6) $(FILES_sonarqube) $(FILES_elk) $(FILES_otel-slim) $(FILES_otel-metrics)

# Captura os argumentos extras passados depois do target (ex: otel otel-slim jaeger)
# Exclui as palavras reservadas de profile, para não tentar resolver FILES_dev / FILES_prod
ARGS := $(filter-out compose logs ps $(PROFILE_KEYWORDS),$(MAKECMDGOALS))
COMPOSE_FILES := $(foreach a,$(ARGS),$(FILES_$(a)))

# Se "elk" estiver entre os argumentos, injeta automaticamente o --env-file necessário
ENV_FILE :=
ifneq (,$(filter elk,$(ARGS)))
ENV_FILE := --env-file ./docker/envs/.env.elasticstack
endif

# Impede o Make de reclamar "No rule to make target 'otel-slim'" etc
%:
	@:

help: ## Lista os targets disponíveis
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
	awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

